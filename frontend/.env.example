# Copy to .env.local for local overrides (gitignored, never committed).
# Vercel's own project env vars are what actually apply to real builds —
# set these in the Vercel dashboard (or `vercel env add`) once, not per
# deploy. Locally, `vercel env pull` writes them into .env.local for you.

# Backend origin the SPA calls. Falls back to localhost:8080 in code
# (api.js) if unset, so this is only needed to point at a real backend.
VITE_API_BASE=https://rewatch-backend-edis.onrender.com

# Canonical site origin — used ONLY in index.html's Open Graph/Twitter meta
# tags via Vite's %VITE_SITE_URL% build-time HTML replacement (no JS-side
# fallback exists for this one, unlike VITE_API_BASE above: an unset value
# leaves the literal "%VITE_SITE_URL%" string in the built HTML instead of
# failing the build or substituting anything sane). Must be set in Vercel's
# project settings before any production build — update this the moment
# the real domain is live, and nowhere else.
VITE_SITE_URL=https://frontend-teal-eight-ij12n87mrc.vercel.app
