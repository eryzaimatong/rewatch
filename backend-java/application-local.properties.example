# Copy to `application-local.properties` (same directory) and fill in.
# That file is gitignored — real secrets never get committed.
#
#   cp application-local.properties.example application-local.properties
#
# Then run from this directory:  mvn spring-boot:run

spring.datasource.password=your_local_postgres_password
tmdb.api.key=your_tmdb_api_key

# Gmail address + an App Password (myaccount.google.com/apppasswords), not your
# real Gmail password. Needed for the forgot-password flow to actually send mail.
spring.mail.username=your_gmail_address@gmail.com
spring.mail.password=your_16_char_app_password

# Your own email, to test the admin-role bootstrap (see AuthController).
rewatch.admin.emails=your_gmail_address@gmail.com
