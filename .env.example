# Copy to `.env` (gitignored) and fill in, then: docker compose up --build

DB_NAME=rewatch_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

TMDB_API_KEY=your_tmdb_api_key

# Generate with: openssl rand -base64 48
JWT_SECRET=change_me

# Comma-separated, no trailing slash. Must include the origin the frontend
# is actually served from (browser tab URL), not the docker service name.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The URL the browser (not the backend container) will use to reach the API.
VITE_API_BASE=http://localhost:8080

# Gmail address + an App Password (myaccount.google.com/apppasswords) for
# sending password-reset emails.
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# The origin the SPA is actually served from — embedded in reset-password links.
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated emails auto-promoted to ADMIN on login. Optional — empty is fine.
ADMIN_EMAILS=
